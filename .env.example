# Copy to .env and fill in. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://devmind:devmind@localhost:5432/devmind
REDIS_URL=redis://localhost:6379/0
API_CORS_ORIGINS=http://localhost:5173

# ---- Chat model (any OpenAI-compatible API) ----
# Local development: Ollama  ->  `ollama pull llama3.2`
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
# Production: OpenAI API
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# With docker compose, reach Ollama on the host with LLM_BASE_URL=http://host.docker.internal:11434/v1
# and change the host ports below if 5432 / 6379 are already taken.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379

# ---- Embeddings: "local" (free, fastembed bge-small, CPU) or "openai" (uses LLM_BASE_URL/KEY) ----
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Size of the pgvector column. Changing it (or the model) means re-indexing.
EMBEDDING_DIMENSION=384

MAX_COMPLETION_TOKENS=600
# Refuse without calling the LLM when the best cosine similarity is below this.
# Depends on the embedding model: ~0.60 for bge-small. Re-calibrate with scripts/evaluate.py.
MIN_SCORE=0.60
