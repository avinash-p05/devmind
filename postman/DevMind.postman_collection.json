{
  "info": {
    "name": "DevMind API",
    "description": "Smoke and retrieval requests for the DevMind POC.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "documentName", "value": "postman-incident.md" },
    { "key": "runId", "value": "replace-with-evaluation-run-id" },
    { "key": "ingestionJobId", "value": "replace-with-ingestion-job-id" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Create incident document",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{documentName}}\",\n  \"source_type\": \"incident\",\n  \"content\": \"Payment deployment exhausted the database connection pool after rollout.\",\n  \"metadata\": {\"path\": \"incidents/{{documentName}}\", \"service\": \"payment-service\"}\n}" },
        "url": "{{baseUrl}}/documents"
      }
    },
    {
      "name": "List documents",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/documents" }
    },
    {
      "name": "Queue ingestion",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"queued-incident.md\",\n  \"source_type\": \"incident\",\n  \"content\": \"The worker processed this incident asynchronously.\",\n  \"metadata\": {\"path\": \"incidents/queued-incident.md\", \"service\": \"payment-service\"}\n}" },
        "url": "{{baseUrl}}/ingestions"
      }
    },
    {
      "name": "Get ingestion status",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/ingestions/{{ingestionJobId}}"
      }
    },
    {
      "name": "Semantic search",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"query\": \"database connection exhaustion\",\n  \"mode\": \"semantic\",\n  \"top_k\": 5\n}" },
        "url": "{{baseUrl}}/search"
      }
    },
    {
      "name": "Keyword search",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"query\": \"connection pool\",\n  \"mode\": \"keyword\",\n  \"top_k\": 5\n}" },
        "url": "{{baseUrl}}/search"
      }
    },
    {
      "name": "Hybrid search",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"query\": \"Why did payment deployment fail?\",\n  \"mode\": \"hybrid\",\n  \"top_k\": 5\n}" },
        "url": "{{baseUrl}}/search"
      }
    },
    {
      "name": "Grounded assistant chat",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"query\": \"Why did the payment service fail after deployment?\",\n  \"top_k\": 5\n}" },
        "url": "{{baseUrl}}/chat"
      }
    },
    {
      "name": "Analyze incident",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"query\": \"Why did the payment service fail after deployment?\",\n  \"service\": \"payment-service\",\n  \"severity\": \"high\",\n  \"top_k\": 5\n}" },
        "url": "{{baseUrl}}/incidents/analyze"
      }
    },
    {
      "name": "Run evaluation",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"dataset_version\": \"v1\",\n  \"mode\": \"hybrid\",\n  \"top_k\": 5\n}" },
        "url": "{{baseUrl}}/evaluations/run"
      }
    },
    {
      "name": "Get evaluation run",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/evaluations/{{runId}}"
      }
    }
  ]
}